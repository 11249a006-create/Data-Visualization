//program:
import pandas as pd
import matplotlib.pyplot as plt
 # Load dataset
 data = pd.read_csv("sales_data.csv")
 # Bar chart
 data.groupby("Category")["Sales"].sum().plot(kind="bar")
 plt.title("Sales by Category")
 plt.show()
 # Pie chart
 data.groupby("Region")["Sales"].sum().plot(
 kind="pie", autopct="%1.1f%%")
 plt.title("Sales by Region")
plt.show()
 # Line chart
 plt.plot(data["Quantity"], data["Sales"])
 plt.title("Sales vs Quantity")
 plt.xlabel("Quantity")
 plt.ylabel("Sales")
plt.show()
/* Output
The program produces three analytical views which can be combined in Tableau into a single inter-
active dashboard.8/

