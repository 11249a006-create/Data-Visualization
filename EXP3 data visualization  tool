//program
import matplotlib.pyplot as plt

# Sample data
x = [1, 2, 3, 4, 5]
y = [2, 4, 6, 8, 10]

# Create a line plot
plt.plot(x, y, marker='o', color='blue', linestyle='-', label='y = 2x')

# Add title and labels
plt.title("Simple Line Graph")
plt.xlabel("X Values")
plt.ylabel("Y Values")

# Display legend and grid
plt.legend()
plt.grid(True)

# Display the graph
plt.show()  

